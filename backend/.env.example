# Copy values into your shell / systemd EnvironmentFile. Spring Boot does not read .env directly.
VAULT_ROOT=/srv/vault
DB_PATH=/opt/note-up/backend/data/notes.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_HOURS=168
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password
HOOK_TOKEN=replace-with-a-random-hook-token
CORS_ORIGINS=https://notes.example.com
INDEX_ON_STARTUP=true
SEED_DEMO_DATA=false
SERVER_PORT=8080