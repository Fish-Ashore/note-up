[Unit]
Description=Note-Up Obsidian publishing backend
After=network.target

[Service]
Type=simple
User=noteup
Group=noteup
WorkingDirectory=/opt/note-up/backend
EnvironmentFile=/etc/note-up.env
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -jar /opt/note-up/backend/note-up-backend.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/note-up/backend/data /srv/vault /srv/backups

[Install]
WantedBy=multi-user.target